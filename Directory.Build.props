<Project>

  <!-- Common paths. -->
  <PropertyGroup>
    <RootPath>$(MSBuildThisFileDirectory)</RootPath>

    <LibPath>$(RootPath)/lib</LibPath>
    <PluginsPath>$(RootPath)/plugins</PluginsPath>
    <SrcPath>$(RootPath)/src</SrcPath>
    <TestPath>$(RootPath)/test</TestPath>

    <LsComponentsPath>$(LibPath)/LiveSplit/components</LsComponentsPath>
    <LsSrcPath>$(LibPath)/LiveSplit/src</LsSrcPath>

    <ArtifactsPath>$(RootPath)/artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- Common properties. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>

    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

</Project>
